# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt

/.sourcemaps
/.versions
/coverage

# Ionic & Capacitor
/.ionic
/www
/platforms
/plugins

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node & Package Managers
/node_modules
/.pnpm-store
pnpm-lock.yaml
pnpm-workspace.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables de entorno, claves y credenciales (Sección 6)
.env
.env.*
*.env
*.jks
*.keystore
*.pem
*.p12
*.key
google-services.json
local.properties

# Android / Gradle generados y binarios
*.apk
*.aab
*.ap_
*.dex
android/.gradle/
android/build/
android/app/build/
android/captures/
android/.idea/
android/local.properties
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# IDEs, editores y asistentes
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*
.gemini/
.agents/
.cursor/

# Miscellaneous
/.angular
/.angular/cache
.sass-cache/
/.nx
/.nx/cache
/connect.lock
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db
Desktop.ini

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
